{
	"schemaVersion": 1,
	"id": "mibclient",
	"version": "${version}",
	"name": "MiB Client",
	"description": "Menu pod prawym Shiftem, edytor HUD i moduły PvP MiB Client.",
	"authors": ["MiB Client"],
	"contact": {
		"homepage": "https://github.com/ban19910k3-sketch/mib-client"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/mibclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["pl.mibclient.mod.fabric.MibClient"]
	},
	"mixins": [
		{ "config": "mibclient.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
